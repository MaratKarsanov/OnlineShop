@model string

@if(Model is null || Model == string.Empty)
{
    <a class="nav-link text-dark" 
        asp-area="" 
        asp-controller="Account" 
        asp-action="Login">
        Login
    </a>
    return;
}
<form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
    <button class="nav-link text-dark"
       type = "submit">
        Logout
    </button>
</form>